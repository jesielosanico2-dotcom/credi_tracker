{
  "database": {
    "name": "credit_tracker",
    "charset": "utf8mb4",
    "collation": "utf8mb4_unicode_ci",
    "engine": "InnoDB"
  },
  "tables": {
    "store_settings": {
      "columns": {
        "id": {
          "type": "TINYINT UNSIGNED",
          "primaryKey": true,
          "check": "id = 1"
        },
        "store_name": {
          "type": "VARCHAR(120)",
          "nullable": false
        },
        "currency": {
          "type": "CHAR(3)",
          "nullable": false,
          "default": "PHP"
        }
      }
    },
    "owner_accounts": {
      "columns": {
        "id": {
          "type": "TINYINT UNSIGNED",
          "primaryKey": true,
          "check": "id = 1"
        },
        "username": {
          "type": "VARCHAR(40)",
          "nullable": false,
          "unique": true
        },
        "password_salt": {
          "type": "CHAR(32)",
          "nullable": false
        },
        "password_hash": {
          "type": "CHAR(128)",
          "nullable": false
        },
        "created_at": {
          "type": "TIMESTAMP",
          "nullable": false,
          "default": "CURRENT_TIMESTAMP"
        }
      }
    },
    "owner_sessions": {
      "columns": {
        "token_hash": {
          "type": "CHAR(64)",
          "primaryKey": true,
          "nullable": false
        },
        "owner_id": {
          "type": "TINYINT UNSIGNED",
          "nullable": false,
          "default": 1
        },
        "created_at": {
          "type": "DATETIME",
          "nullable": false
        },
        "expires_at": {
          "type": "DATETIME",
          "nullable": false
        }
      },
      "foreignKeys": [
        {
          "column": "owner_id",
          "references": {
            "table": "owner_accounts",
            "column": "id"
          },
          "onDelete": "CASCADE"
        }
      ],
      "indexes": [
        {
          "name": "idx_sessions_expiry",
          "columns": ["expires_at"]
        }
      ]
    },
    "customers": {
      "columns": {
        "id": {
          "type": "VARCHAR(36)",
          "primaryKey": true,
          "nullable": false
        },
        "name": {
          "type": "VARCHAR(80)",
          "nullable": false
        },
        "phone": {
          "type": "VARCHAR(32)",
          "nullable": false,
          "default": ""
        },
        "purok": {
          "type": "VARCHAR(80)",
          "nullable": false
        },
        "credit_limit": {
          "type": "DECIMAL(12,2)",
          "nullable": false,
          "check": "credit_limit > 0"
        },
        "status": {
          "type": "ENUM",
          "values": ["active", "suspended"],
          "nullable": false,
          "default": "active"
        },
        "created_at": {
          "type": "DATETIME",
          "nullable": false
        }
      },
      "indexes": [
        {
          "name": "idx_customers_name",
          "columns": ["name"]
        }
      ]
    },
    "applications": {
      "columns": {
        "id": {
          "type": "VARCHAR(36)",
          "primaryKey": true,
          "nullable": false
        },
        "type": {
          "type": "ENUM",
          "values": ["newCustomer", "limitIncrease"],
          "nullable": false,
          "default": "newCustomer"
        },
        "status": {
          "type": "ENUM",
          "values": ["pending", "approved", "rejected"],
          "nullable": false,
          "default": "pending"
        },
        "customer_name": {
          "type": "VARCHAR(80)",
          "nullable": false
        },
        "phone": {
          "type": "VARCHAR(32)",
          "nullable": false,
          "default": ""
        },
        "purok": {
          "type": "VARCHAR(80)",
          "nullable": false,
          "default": ""
        },
        "requested_limit": {
          "type": "DECIMAL(12,2)",
          "nullable": false,
          "check": "requested_limit > 0"
        },
        "note": {
          "type": "VARCHAR(240)",
          "nullable": false,
          "default": ""
        },
        "customer_id": {
          "type": "VARCHAR(36)",
          "nullable": true
        },
        "created_at": {
          "type": "DATETIME",
          "nullable": false
        },
        "reviewed_at": {
          "type": "DATETIME",
          "nullable": true
        }
      },
      "foreignKeys": [
        {
          "column": "customer_id",
          "references": {
            "table": "customers",
            "column": "id"
          },
          "onDelete": "SET NULL"
        }
      ],
      "indexes": [
        {
          "name": "idx_applications_status_created",
          "columns": ["status", "created_at"]
        }
      ]
    },
    "transactions": {
      "columns": {
        "id": {
          "type": "VARCHAR(36)",
          "primaryKey": true,
          "nullable": false
        },
        "customer_id": {
          "type": "VARCHAR(36)",
          "nullable": false
        },
        "type": {
          "type": "ENUM",
          "values": ["credit", "payment"],
          "nullable": false
        },
        "amount": {
          "type": "DECIMAL(12,2)",
          "nullable": false,
          "check": "amount > 0"
        },
        "note": {
          "type": "VARCHAR(240)",
          "nullable": false,
          "default": ""
        },
        "transaction_date": {
          "type": "DATE",
          "nullable": false
        },
        "due_date": {
          "type": "DATE",
          "nullable": true
        },
        "created_at": {
          "type": "DATETIME",
          "nullable": false
        },
        "voided_at": {
          "type": "DATETIME",
          "nullable": true
        },
        "void_reason": {
          "type": "VARCHAR(240)",
          "nullable": false,
          "default": ""
        }
      },
      "foreignKeys": [
        {
          "column": "customer_id",
          "references": {
            "table": "customers",
            "column": "id"
          },
          "onDelete": "RESTRICT"
        }
      ],
      "indexes": [
        {
          "name": "idx_transactions_customer_date",
          "columns": ["customer_id", "transaction_date", "created_at"]
        },
        {
          "name": "idx_transactions_due_date",
          "columns": ["due_date"]
        }
      ],
      "checks": [
        "type <> 'credit' OR due_date IS NOT NULL",
        "type <> 'payment' OR due_date IS NULL"
      ]
    }
  },
