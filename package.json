{
  "name": "credit-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A MySQL-backed credit tracker for a sari-sari store.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test",
