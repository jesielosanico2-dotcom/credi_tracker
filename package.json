{
  "name": "credit-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A MySQL-backed credit tracker for a sari-sari store.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node scripts/dev.js",
    "test": "node --test",
    "owner:reset-password": "node scripts/reset-owner-password.js",
    "owner:reset-password:cloud": "node scripts/reset-cloud-owner-password.js",
    "db:import-json": "node scripts/json-to-mysql.js",
    "db:import-cloud": "node scripts/json-to-mysql.js --cloud",
    "db:import-d1": "node scripts/json-to-d1.js",
    "db:export-json": "node scripts/mysql-to-json.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:d1:create": "wrangler d1 create credit-tracker",
    "cf:d1:migrate:local": "wrangler d1 migrations apply credit-tracker --local",
    "cf:d1:migrate": "wrangler d1 migrations apply credit-tracker --remote"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mysql2": "^3.14.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
