{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "credi-tracker",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "credit-tracker",
      "database_id": "eab82eaf-7252-4fbd-bf80-f4a13e964fe9",
      "migrations_dir": "migrations/d1"
    }
  ]
}
